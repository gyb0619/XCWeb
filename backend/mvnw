#!/bin/sh
LOCAL_MVN="/c/Users/CaYPt/.m2/wrapper/dists/apache-maven-3.9.16/0daed3be3ebd1c706f0e69e8b07c6b73f5cc4ea3dfce72a8d0ec2e849ca2ddb0/bin/mvn"
if [ -x "$LOCAL_MVN" ]; then
    exec "$LOCAL_MVN" "$@"
elif command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
else
    echo "Error: Maven (mvn) not found." >&2
    exit 1
fi
