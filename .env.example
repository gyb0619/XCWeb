# ==============================================================================
# XCWeb (Xtreme Cognitive Web) Environment Variables Template (.env.example)
# Copy this file to .env or export variables in your shell before starting.
# ==============================================================================

# 1. Server & Database Configuration
SERVER_PORT=8080
XCWEB_DB_PATH=xcweb.db
XCWEB_TIMEZONE=Asia/Shanghai

# 2. JWT & Anonymous Token Signing Secret (HMAC-SHA256, at least 32 characters)
XCWEB_JWT_SECRET=xcweb-electric-cyber-blue-hmac-sha256-secret-key-2026-xtreme-cognitive

# 3. Initial Privileged Accounts (Admin & Developer)
# Note: Public registration (/api/auth/register) only creates 'user' accounts.
# Admin and Dev accounts are initialized on startup from these environment variables.
XCWEB_ADMIN_USERNAME=admin
XCWEB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
XCWEB_DEV_USERNAME=developer
XCWEB_DEV_PASSWORD=CHANGE_ME_DEV_PASSWORD

# 4. Quota & Rate Limiting Thresholds (Reset daily at 00:00 in XCWEB_TIMEZONE)
XCWEB_QUOTA_GUEST_DAILY_LIMIT=10
XCWEB_QUOTA_GUEST_CONTEXT_LIMIT=4000
XCWEB_QUOTA_USER_DAILY_LIMIT=50
XCWEB_QUOTA_USER_CONTEXT_LIMIT=16000
XCWEB_QUOTA_IP_DAILY_LIMIT=30
XCWEB_QUOTA_TOKEN_ISSUE_DAILY_LIMIT=5

# 5. Preset LLM Provider API Keys (Server-side only, never exposed to frontend)
# If left empty or unreachable, XCWeb automatically falls back to Built-in Cognitive Mock Core.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 6. Upstream Timeout & Fallback Policy
XCWEB_LLM_CONNECT_TIMEOUT_MS=5000
XCWEB_LLM_FIRST_TOKEN_TIMEOUT_MS=8000
XCWEB_LLM_MAX_CONSECUTIVE_FAILURES=3
